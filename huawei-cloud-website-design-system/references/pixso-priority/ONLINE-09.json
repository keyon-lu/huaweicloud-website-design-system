            "4:1431",
            "4:2980"
          ]
        },
        {
          "text": "默认图标大小为72px，倒角为16px，倒角随尺寸压缩变化而缩放",
          "fontSize": 14,
          "lineHeight": {
            "unit": "PIXELS",
            "value": 22
          },
          "sourceNodeIds": [
            "4:1436",
            "4:2951"
          ]
        },
        {
          "text": "主体图形到圆角矩形背景外边缘的距离不得小于2px",
          "fontSize": 14,
          "lineHeight": {
            "unit": "PIXELS",
            "value": 22
          },
          "sourceNodeIds": [
            "4:1441"
          ]
        },
        {
          "text": "主体图形区域默认大小为48x48px，但可根据图标形状的特殊性适当增加视觉重量，确保图标视觉整体感受的一致性，但主图形到外轮廓的距离不得小于2px；主体图形颜色根据服务的类别选取色板中的颜色（线性渐变），投影值采用对应颜色的20%-25%（纯色）",
          "fontSize": 14,
          "lineHeight": {
            "unit": "PIXELS",
            "value": 22
          },
          "sourceNodeIds": [
            "4:1451"
          ]
        },
        {
          "text": "采用APP化的形态设计，图标结合业务属性表达含义，质感趋于统一，配色上可进行差异化表达。\n使用场景：产品页banner、精选推荐、建议搭配使用等需要用到产品服务图标的场景。\n备注：多个服务以分类列表形式展示在同一个页面时，不显示图标（如顶部产品下拉导航）。",
          "fontSize": 14,
          "lineHeight": {
            "unit": "PIXELS",
            "value": 22
          },
          "sourceNodeIds": [
            "4:1459"
          ]
        },
        {
          "text": "88px",
          "fontSize": 10,
          "lineHeight": {
            "unit": "AUTO"
          },
          "sourceNodeIds": [
            "I4:1515;2:3768"
          ]
        },
        {
          "text": "40px",
          "fontSize": 10,
          "lineHeight": {
            "unit": "AUTO"
          },
          "sourceNodeIds": [
            "I4:1516;2:3768"
          ]
        },
        {
          "text": "32px",
          "fontSize": 10,
          "lineHeight": {
            "unit": "AUTO"
          },
          "sourceNodeIds": [
            "I4:1517;2:3768"
          ]
        },
        {
          "text": "24px",
          "fontSize": 10,
          "lineHeight": {
            "unit": "AUTO"
          },
          "sourceNodeIds": [
            "I4:1518;2:3768"
          ]
        },
        {
          "text": "图标放在非白色背景上\n背景色：纯色（#FFFFFF）\n描边：无\n背景投影：纯色（X:0 | Y:8 | Blur:6 | #999999 Alpha 25%），PEP配置时有多个投影色值，建议选择灰色投影，切图时不需要\n图形颜色：线性渐变（根据图标色板及语义）\n图形投影：无",
          "fontSize": 14,
          "lineHeight": {
            "unit": "PIXELS",
            "value": 22
          },
          "sourceNodeIds": [
            "4:1704"
          ]
        },
        {
          "text": "华为云知识湖存储LMS，用于存储、检索、分析多维向量数据。支持百亿向量、TOP 100毫秒级检索。LMS不仅能为大模型提供外部知识库，提高知识回答准确性，还可应用于推荐系统、自然语言处理等领域",
          "fontSize": 16,
          "lineHeight": {
            "unit": "PIXELS",
            "value": 24
          },
          "sourceNodeIds": [
            "4:1981"
          ]
        },
        {
          "text": "架构图里公共性图标尺寸28*28px,根据具体图形语意来确定图标形态，推荐面性，\n可根据图标形状的特殊性适当增加视觉重量，确保图标视觉整体感受的一致性",
          "fontSize": 14,
          "lineHeight": {
            "unit": "AUTO"
          },
          "sourceNodeIds": [
            "4:2057"
          ]
        },
        {
          "text": "28px",
          "fontSize": 10,
          "lineHeight": {
            "unit": "AUTO"
          },
          "sourceNodeIds": [
            "4:2124",
            "4:2128",
            "4:2217",
            "4:2221"
          ]
        },
        {
          "text": "不得大于2px",
          "fontSize": 10,
          "lineHeight": {
            "unit": "AUTO"
          },
          "sourceNodeIds": [
            "4:2136",
            "4:2234"
          ]
        },
        {
          "text": "26x26px",
          "fontSize": 10,
          "lineHeight": {
            "unit": "AUTO"
          },
          "sourceNodeIds": [
            "4:2137",
            "4:2235"
          ]
        },
        {
          "text": "架构图里产品服务图标等比缩放到28*28px,使用服务图标中的图形",
          "fontSize": 14,
          "lineHeight": {
            "unit": "AUTO"
          },
          "sourceNodeIds": [
            "4:2144"
          ]
        },
        {
          "text": "容器服务：\n统一镜像管理\n统一容器集群管理\n自动弹性伸缩\n基于VPC混合云互联",
          "fontSize": 12,
          "lineHeight": {
            "unit": "PIXELS",
            "value": 18
          },
          "sourceNodeIds": [
            "4:2494"
          ]
        },
        {
          "text": "颜色统一用蓝色（#1476FF）\n若服务图标的图形为线性，在架构图内使用时建议转为面性图标展示（如ELB）",
          "fontSize": 14,
          "lineHeight": {
            "unit": "PIXELS",
            "value": 22
          },
          "sourceNodeIds": [
            "4:2798"
          ]
        },
        {
          "text": "反白主体图形区域默认大小为48x48px，但可根据图标形状的特殊性适当增加视觉重量，确保图标视觉整体感受的一致性",
          "fontSize": 14,
          "lineHeight": {
            "unit": "PIXELS",
            "value": 22
          },
          "sourceNodeIds": [
            "4:2954"
          ]
        },
        {
          "text": "主体图形则采用反白和微色彩结合的设计，且外轮廓应使用圆角，圆角大小不做限制，根据具体图形语意来确定",
          "fontSize": 14,
          "lineHeight": {
            "unit": "PIXELS",
            "value": 22
          },
          "sourceNodeIds": [
            "4:2957"
          ]
        },
        {
          "text": "反白主体图形到圆角矩形背景外边缘的距离不得小于2px",
          "fontSize": 14,
          "lineHeight": {
            "unit": "PIXELS",
            "value": 22
          },
          "sourceNodeIds": [
            "4:2960"
          ]
        },
        {
          "text": "默认为72px，采用APP化的形态设计，结合实际业务进行多色渐变手法和质感上的艺术化表达，主体图形则采用反白和微色彩结合的设计，根据视觉最佳效果处理即可。\n使用场景：首页导航、解决方案产品页、购买页、解决方案控制台的了解与购买",
          "fontSize": 14,
          "lineHeight": {
            "unit": "PIXELS",
            "value": 22
          },
          "sourceNodeIds": [
            "4:3074"
          ]
        },
        {
          "text": "使用线性图标，要求32*32px的安全尺寸，图标粗细1px，颜色#191919（绘制规格与系统图标一致，圆角等比例放大）。\n使用场景（控制台/官网均可用）：适用于首页及子站页面内表达服务能力的图标入口。",
          "fontSize": 14,
          "lineHeight": {
            "unit": "PIXELS",
            "value": 22
          },
          "sourceNodeIds": [
            "4:3077"
          ]
        },
        {
          "text": "默认图标大小为32px，描边粗细 1px ",
          "fontSize": 14,
          "lineHeight": {
            "unit": "AUTO"
          },
          "sourceNodeIds": [
            "4:3085"
          ]
        },
        {
          "text": "圆角4px内外圆角依据线条扩展",
          "fontSize": 14,
          "lineHeight": {
            "unit": "AUTO"
          },
          "sourceNodeIds": [
            "4:3095"
          ]
        },
        {
          "text": "图标间隙 4px",
          "fontSize": 14,
          "lineHeight": {
            "unit": "AUTO"
          },
          "sourceNodeIds": [
            "4:3100"
          ]
        },
        {
          "text": "圆角4px\n内外圆角依据线条扩展",
          "fontSize": 10,
          "lineHeight": {
            "unit": "AUTO"
          },
          "sourceNodeIds": [
            "4:3188"
          ]
        },
        {
          "text": "官网首页APP图标/H5图标",
          "fontSize": 24,
          "lineHeight": {
            "unit": "AUTO"
          },
          "sourceNodeIds": [
            "4:3258"
          ]
        },
        {
          "text": "按业务的场景切换，采用彩色面性图标，结合主要业务属性，主图形线性图标表达正确意思，质感趋于统一，配色上可进行差异化表达。\n使用场景：华为云官网首页APP及H5",
          "fontSize": 14,
          "lineHeight": {
            "unit": "PIXELS",
            "value": 22
          },
          "sourceNodeIds": [
            "4:3259"
          ]
        },
        {
          "text": "建议反馈",
          "fontSize": 13,
          "lineHeight": {
            "unit": "PIXELS",
            "value": 21
          },
          "sourceNodeIds": [
            "4:3311"
          ]
        },
        {
          "text": "安全区域为2px",
          "fontSize": 10,
          "lineHeight": {
            "unit": "AUTO"
          },
          "sourceNodeIds": [
            "4:3409"
          ]
        },
        {
