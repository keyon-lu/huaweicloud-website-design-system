{
  "name": "huawei-website-search-validation",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "build-storybook": "storybook build --disable-telemetry",
    "storybook": "storybook dev -p 6006 --host 127.0.0.1 --disable-telemetry",
    "index": "node scripts/build-index.mjs",
    "start": "node server/server.mjs",
    "test": "node --test tests/*.test.mjs",
    "verify": "node scripts/verify.mjs"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@storybook/addon-docs": "10.6.2",
    "@storybook/react-vite": "10.6.2",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "axe-core": "4.10.3",
    "storybook": "10.6.2",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
